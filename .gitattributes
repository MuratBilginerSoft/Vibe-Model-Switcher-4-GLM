# Normalize all text files to LF in the repo and working tree on every
# platform. This stops the constant CRLF<->LF churn between Windows and macOS.
* text=auto eol=lf

# Treat binary assets as binary so git never touches their bytes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.dmg   binary
*.exe   binary
*.node  binary
